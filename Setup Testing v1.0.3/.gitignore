# MacroPad Pro - Gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
venv/
env/
ENV/

# Environment variables
.env
*.env
!.env.example

# IDE
.vscode/
.idea/
*.sublime-*

# Logs
*.log
macropad.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# Build artifacts
*.exe
*.spec
installer/

# Backup files
*.backup
*.bak
*~

# Test files
test_*.py
*_test.py
crash_report_*.md
diagnostic*.md

# Temporary files
*.tmp
*.temp
TEST_FILE_*.txt
