/*
 * Macropad Pro - Themed UI
 */

/* -- Base Styles -- */
QWidget {
    background-color: %(bg_color)s;
    font-family: "Segoe UI", "Inter", sans-serif;
    color: %(text_main)s;
    font-size: 10pt;
}

QLabel {
    background-color: transparent;
    color: %(text_main)s;
}

/* -- Main Layout Frames -- */
QFrame#sidebar {
    background-color: %(surface_color)s;
    border-right: 1px solid %(border_color)s;
}

QFrame#main_area {
    background-color: %(bg_color)s;
    border: none;
}

QFrame#create_panel, QFrame#macro_list_panel {
    background-color: %(surface_color)s;
    border: 1px solid %(border_color)s;
    border-radius: 12px;
}

/* -- Buttons -- */
QPushButton {
    background-color: %(surface_highlight)s;
    color: %(text_main)s;
    padding: 10px 16px;
    border-radius: 8px;
    border: 1px solid %(border_color)s;
    font-weight: 600;
    outline: none;
}

QPushButton:hover {
    background-color: %(border_color)s;
    border: 1px solid %(text_muted)s;
}

QPushButton:pressed {
    background-color: %(bg_color)s;
}

/* Profile Action Buttons (Icon Only) */
QPushButton#profile_action_btn {
    padding: 8px;
    background-color: transparent;
    border: 1px solid transparent;
}

QPushButton#profile_action_btn:hover {
    background-color: %(border_color)s;
    border: 1px solid %(text_muted)s;
}

/* Primary Action Button (Save, etc) */
QPushButton#cta {
    background-color: %(primary_color)s;
    border: 1px solid %(primary_color)s;
    color: white;
}

QPushButton#cta:hover {
    background-color: %(primary_hover)s;
    border: 1px solid %(primary_hover)s;
}

QPushButton#cta:pressed {
    background-color: %(primary_pressed)s;
}

/* Sidebar Navigation Buttons */
QPushButton#nav_btn {
    background-color: transparent;
    border: none;
    padding: 12px 16px;
    text-align: left;
    border-radius: 8px;
    color: %(text_muted)s;
    font-size: 10.5pt;
}

QPushButton#nav_btn:hover {
    background-color: %(surface_highlight)s;
    color: %(text_main)s;
}

QPushButton#nav_btn:checked {
    background-color: %(surface_highlight)s;
    color: %(primary_color)s; /* Primary Color Text */
    font-weight: 700;
    border-left: 3px solid %(primary_color)s; /* Accent bar */
}



/* -- Input Fields -- */
QLineEdit, QTextEdit, QComboBox {
    background-color: %(input_bg)s;
    color: %(text_main)s;
    border: 1px solid %(border_color)s;
    border-radius: 8px;
    padding: 10px;
    selection-background-color: %(primary_color)s;
}

QLineEdit:focus, QTextEdit:focus, QComboBox:focus {
    border: 1px solid %(primary_color)s;
    background-color: %(input_focus_bg)s;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: url(%(assets_path)s/icons/chevron-down.svg);
    width: 12px;
    height: 12px;
}

/* -- Tabs -- */
QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    background-color: transparent;
    color: %(text_muted)s;
    padding: 10px 20px;
    border-bottom: 2px solid transparent;
    font-weight: 600;
    font-size: 10.5pt;
}

QTabBar::tab:hover {
    color: %(text_main)s;
}

QTabBar::tab:selected {
    color: %(primary_color)s;
    border-bottom: 2px solid %(primary_color)s;
}

/* -- Key Widget -- */
KeyWidget {
    background-color: %(key_bg)s;
    border-radius: 5px;
    border: none;
}

KeyWidget:hover {
    background-color: %(key_hover)s;
}

KeyWidget[is_pressed="true"] {
    background-color: %(key_pressed)s;
}

KeyWidget[checked="true"] {
    border: 2px solid %(key_selected_border)s; /* Keep selection indicator */
    background-color: %(key_selected_bg)s; /* Keep dark bg */
}

#key_name_label {
    font-size: 14pt;
    font-weight: 700;
    color: #a2a09f;
}

KeyWidget[checked="true"] #key_name_label {
    color: %(primary_color)s;
}

#key_macro_label {
    font-size: 8pt;
    font-weight: 700;
    color: #a2a09f;
}

/* -- Macro List Item -- */
#MacroCard {
    background-color: %(surface_highlight)s;
    border-radius: 8px;
    margin: 4px 0;
    padding: 10px;
    border: 1px solid transparent;
}

#MacroCard:hover {
    background-color: %(border_color)s;
    border: 1px solid %(text_muted)s;
}

#MacroCard[assigned="true"] {
    background-color: %(macro_card_assigned_bg)s; /* Indigo tint */
    border: 1px solid %(macro_card_assigned_border)s;
}

#MacroCard #AssignButton {
    font-size: 9pt;
    font-weight: 600;
    color: %(text_main)s;
    background-color: %(border_color)s;
    padding: 6px 12px;
    border-radius: 6px;
    border: 1px solid %(text_muted)s;
}

#MacroCard #AssignButton:hover {
    background-color: %(key_hover)s;
    color: white;
}

#MacroCard[assigned="true"] #AssignButton {
    background-color: %(primary_color)s;
    color: white;
    border: none;
}

#macro_name_label {
    font-weight: 600;
    color: %(text_main)s;
    font-size: 10pt;
}

/* -- Scrollbars -- */
QScrollBar:vertical {
    border: none;
    background: %(scrollbar_bg)s;
    width: 6px;
    margin: 0px;
    border-radius: 3px;
}

QScrollBar::handle:vertical {
    background: %(scrollbar_handle)s;
    min-height: 20px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: %(scrollbar_handle_hover)s;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

/* -- Headers & Text -- */
#header_title {
    font-size: 24pt;
    font-weight: 700;
    color: %(text_main)s;
    letter-spacing: -0.5px;
}

#active_profile_label {
    color: %(text_muted)s;
    font-weight: 600;
}

#active_profile_name_label {
    color: %(primary_color)s;
    font-weight: 700;
    font-size: 11pt;
}

#create_panel_header {
    color: %(text_muted)s;
    font-size: 9pt;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

/* -- Record Button -- */
QPushButton#record_btn {
    background-color: %(surface_highlight)s;
    border: 1px solid %(border_color)s;
}

QPushButton#record_btn:checked, QPushButton#record_btn[blinking="true"] {
    background-color: %(danger_color)s;
    color: white;
    border: 1px solid %(danger_color)s;
}

/* -- Connection Status -- */
#status_text_connected {
    font-weight: 600;
    font-size: 11pt;
    color: %(success_color)s; /* Green */
}

#status_text_disconnected {
    font-weight: 600;
    font-size: 11pt;
    color: %(danger_color)s; /* Red */
}

/* -- Logo -- */
#logo {
    font-size: 14pt;
    font-weight: 800;
    color: %(text_main)s;
    padding-left: 8px;
}

#profile_label {
    color: #6B7280;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1px;
}

/* Macro Dialog Container */
#macro_dialog_container {
    border: none;
    border-radius: 8px;
    background-color: %(surface_color)s;
}

#version_label {
    color: %(text_muted)s;
    font-size: 8pt;
    font-weight: 600;
}