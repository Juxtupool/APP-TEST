# Environment Configuration for MacroPad Pro

# GitHub API Configuration
# Get your token from: https://github.com/settings/tokens
# Required scopes: repo (for community features)
GITHUB_TOKEN=your_github_token_here

# Optional: Override default repositories
# GITHUB_FIRMWARE_REPO=your-username/firmware-repo
# GITHUB_APP_REPO=your-username/app-repo
# GITHUB_COMMUNITY_REPO=your-username/community-repo
